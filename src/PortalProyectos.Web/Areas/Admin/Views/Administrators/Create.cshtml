@model PortalProyectos.Web.Models.Admin.AdministrativeUserForm
@{ ViewData["Title"] = "Crear administrador"; }
<div class="page-head"><div><span class="eyebrow">Sólo Superadministrador</span><h1>Crear administrador</h1><p>Se generará una contraseña temporal aleatoria y se pedirá cambiarla al primer acceso.</p></div><a class="btn btn-ghost" href="/Admin/Administrators">← Administradores</a></div>
<section class="panel-card admin-create-card"><form method="post" class="d-grid gap-3">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="text-danger"></div><div><label asp-for="FullName" class="form-label">Nombre completo</label><input asp-for="FullName" class="form-control" autocomplete="name" /><span asp-validation-for="FullName" class="text-danger small"></span></div><div><label asp-for="EmployeeNumber" class="form-label">Identificador administrativo</label><input asp-for="EmployeeNumber" class="form-control" autocomplete="off" /><span asp-validation-for="EmployeeNumber" class="text-danger small"></span></div><div><label asp-for="Email" class="form-label">Correo</label><input asp-for="Email" class="form-control" autocomplete="email" /><span asp-validation-for="Email" class="text-danger small"></span></div><div class="alert alert-info mb-0">La contraseña temporal sólo se mostrará una vez tras crear o restablecer. Nunca se guarda en texto plano.</div><button class="btn btn-primary justify-self-start">Crear cuenta administrativa</button></form></section>
