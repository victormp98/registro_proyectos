@model PortalProyectos.Web.Models.Admin.AdminProjectsViewModel
@{
    ViewData["Title"] = Model.ReviewQueue ? "Revisiones" : "Proyectos";
    string Label(ProjectAdministrativeStatus status) => status switch { ProjectAdministrativeStatus.Draft => "Borrador", ProjectAdministrativeStatus.Submitted => "Enviado", ProjectAdministrativeStatus.UnderReview => "En revisión", ProjectAdministrativeStatus.ChangesRequested => "Correcciones", ProjectAdministrativeStatus.Resubmitted => "Reenviado", ProjectAdministrativeStatus.Approved => "Aprobado", _ => "Rechazado" };
}
<div class="page-head"><div><span class="eyebrow">@(Model.ReviewQueue ? "Bandeja de trabajo" : "Seguimiento institucional")</span><h1>@(Model.ReviewQueue ? "Revisiones" : "Proyectos")</h1><p>@(Model.ReviewQueue ? "Toma solicitudes pendientes y continúa las revisiones asignadas." : "Consulta el estado de todos los proyectos enviados.")</p></div><span class="status-badge badge-pending">@Model.Projects.Count resultado(s)</span></div>
<div class="project-filter-shell"><form method="get" action="@(Model.ReviewQueue ? "/Admin/Reviews" : Url.Action("Index"))" class="filter-bar project-filter-admin">
    <div class="search-field"><svg class="icon"><use href="/assets/icons.svg#icon-search"></use></svg><input name="search" value="@Model.Filter.Search" class="form-control" placeholder="Proyecto, responsable o matrícula" aria-label="Buscar proyectos" /></div>
    <select name="status" class="form-select" aria-label="Estado"><option value="">Todos los estados</option>@foreach (var state in Enum.GetValues<ProjectAdministrativeStatus>().Where(x => x != ProjectAdministrativeStatus.Draft)) { <option value="@state" selected="@(Model.Filter.Status == state)">@Label(state)</option> }</select>
    <select name="careerId" class="form-select" asp-items="Model.Careers" aria-label="Carrera"><option value="">Todas las carreras</option></select>
    <select name="subjectId" class="form-select" asp-items="Model.Subjects" aria-label="Materia"><option value="">Todas las materias</option></select>
    <select name="schoolCycleId" class="form-select" asp-items="Model.SchoolCycles" aria-label="Ciclo"><option value="">Todos los ciclos</option></select>
    <div class="project-filter-actions"><button class="btn btn-outline-primary" type="submit">Filtrar</button><a class="btn btn-ghost" href="@(Model.ReviewQueue ? "/Admin/Reviews" : Url.Action("Index"))">Limpiar</a></div>
</form></div>
<section class="panel-card p-0 overflow-hidden">
@if (Model.Projects.Count == 0) { <div class="empty-state border-0 shadow-none"><span class="empty-illustration"><svg class="icon"><use href="/assets/icons.svg#icon-folder"></use></svg></span><h2>No hay proyectos con estos filtros</h2><p>Las solicitudes aparecerán cuando los alumnos las envíen.</p></div> }
else { <div class="table-responsive"><table class="table data-table project-admin-table"><thead><tr><th>Proyecto</th><th>Responsable</th><th>Clasificación</th><th>Estado</th><th>Asignación</th><th></th></tr></thead><tbody>@foreach (var project in Model.Projects) { <tr><td><div class="table-person"><strong>@project.Name</strong><span>@project.SchoolCycle · v@project.VersionNumber / revisión @project.ReviewNumber</span></div></td><td><div class="table-person"><strong>@project.ResponsibleName</strong><span>@project.ResponsibleStudentNumber · @project.Career</span></div></td><td><div class="table-person"><strong>@project.Subject</strong><span>@(project.SubmittedAtUtc?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "Sin fecha")</span></div></td><td><span class="status-badge project-status status-@project.Status.ToString().ToLowerInvariant()">@Label(project.Status)</span></td><td><span class="small @(project.AssignedAdministratorName is null ? "text-secondary" : "fw-bold")">@(project.AssignedAdministratorName ?? "Sin asignar")</span></td><td class="text-end"><a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@project.Id">Revisar</a></td></tr> }</tbody></table></div> }
</section>
