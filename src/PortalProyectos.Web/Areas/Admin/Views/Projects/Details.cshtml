@model PortalProyectos.Web.Models.Admin.AdminProjectDetailsViewModel
@{
    ViewData["Title"] = "Revisión de proyecto";
    var project = Model.Project;
    var document = ViewBag.ProjectDocument as PortalProyectos.Application.Notifications.ProjectDocumentItem;
    string StatusLabel(ProjectAdministrativeStatus status) => status switch { ProjectAdministrativeStatus.Submitted => "Enviado", ProjectAdministrativeStatus.UnderReview => "En revisión", ProjectAdministrativeStatus.ChangesRequested => "Correcciones", ProjectAdministrativeStatus.Resubmitted => "Reenviado", ProjectAdministrativeStatus.Approved => "Aprobado", ProjectAdministrativeStatus.Rejected => "Rechazado", _ => "Borrador" };
    string EventLabel(ProjectHistoryEventType type) => type switch { ProjectHistoryEventType.Created => "Proyecto creado", ProjectHistoryEventType.Submitted => "Enviado a revisión", ProjectHistoryEventType.SubmissionCancelled => "Envío cancelado", ProjectHistoryEventType.ReviewStarted => "Revisión iniciada", ProjectHistoryEventType.ChangesRequested => "Correcciones solicitadas", ProjectHistoryEventType.Resubmitted => "Proyecto reenviado", ProjectHistoryEventType.Approved => "Proyecto aprobado", ProjectHistoryEventType.Rejected => "Proyecto rechazado", ProjectHistoryEventType.ParticipantAdded => "Participante agregado", ProjectHistoryEventType.ParticipantRemoved => "Participante retirado", _ => "Borrador actualizado" };
}
<div class="page-head"><div><span class="eyebrow">Proyecto #@project.Id · versión @project.VersionNumber</span><h1>@project.Name</h1><p>@project.ResponsibleName · @project.ResponsibleStudentNumber</p></div><span class="status-badge project-status status-@project.Status.ToString().ToLowerInvariant()">@StatusLabel(project.Status)</span></div>
<div class="review-workspace"><div class="d-grid gap-3"><section class="panel-card"><div class="panel-card-head"><h2>Ficha para revisión</h2><span>Revisión @(project.Reviews.FirstOrDefault()?.ReviewNumber ?? 0)</span></div><dl class="detail-list compact"><div><dt>Responsable</dt><dd>@project.ResponsibleName</dd></div><div><dt>Carrera</dt><dd>@project.Career</dd></div><div><dt>Materia</dt><dd>@project.Subject</dd></div><div><dt>Tipo</dt><dd>@project.ProjectType</dd></div><div><dt>Ciclo</dt><dd>@project.SchoolCycle</dd></div><div><dt>Desarrollo</dt><dd>@(project.Status != ProjectAdministrativeStatus.Approved ? "Disponible al aprobar" : project.DevelopmentStatus == ProjectDevelopmentStatus.InProgress ? "En proceso" : "Terminado")</dd></div><div><dt>Asesor</dt><dd>@(project.Advisor ?? "No especificado")</dd></div><div><dt>Fecha estimada</dt><dd>@(project.EstimatedCompletionDate?.ToString("dd/MM/yyyy") ?? "No especificada")</dd></div></dl></section>
<section class="panel-card"><div class="content-block"><span class="eyebrow">Planteamiento</span><h2>Problema identificado</h2><p>@project.ProblemStatement</p></div><div class="content-block"><span class="eyebrow">Propuesta</span><h2>Solución o innovación</h2><p>@project.ProposedSolution</p></div></section>
<section class="panel-card"><div class="panel-card-head"><h2>Participantes</h2><span>@project.Participants.Count</span></div><div class="participant-list">@foreach (var participant in project.Participants) { <article class="participant-card"><span class="avatar">@participant.FullName[0]</span><div><strong>@participant.FullName</strong><span>@participant.StudentNumber · @participant.Career · @participant.Grade @participant.Group</span><small>@(participant.IsResponsible ? "Responsable principal" : participant.UserId is null ? "Captura manual" : "Cuenta vinculada")</small></div></article> }</div></section>
@if (document is not null) { <section class="panel-card"><div class="panel-card-head"><h2>Documentación privada</h2></div><div class="document-file"><span class="document-file-icon"><svg class="icon"><use href="/assets/icons.svg#icon-book"></use></svg></span><div><strong>@document.OriginalFileName</strong><small>@(document.SizeBytes / 1024d / 1024d).ToString("0.0") MB · v@project.VersionNumber</small></div><a class="btn btn-sm btn-outline-primary" href="/Admin/Projects/Document/@project.Id">Ver PDF</a></div></section> }
<section class="panel-card"><div class="panel-card-head"><h2>Historial</h2></div><div class="review-timeline">@foreach (var item in project.History) { <article><span class="timeline-dot"></span><div><strong>@EventLabel(item.EventType)</strong><p>@item.Notes</p><small>@item.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm") · @item.ActorDisplayName</small></div></article> }</div></section></div>
<aside class="review-sidebar"><section class="panel-card sticky-review"><div class="panel-card-head"><h2>Control de revisión</h2></div>
    @if (Model.CanTake) { <div class="review-action-intro"><span class="feature-icon"><svg class="icon"><use href="/assets/icons.svg#icon-check"></use></svg></span><h3>Proyecto disponible</h3><p>Tómalo para bloquear decisiones de otros administradores.</p></div><form asp-action="TakeReview" asp-route-id="@project.Id" method="post"><button class="btn btn-primary w-100" type="submit" data-submit-once>Tomar revisión</button></form> }
    else if (Model.CanDecide) { <div class="assigned-review"><span class="toast-status-dot"></span><strong>Revisión asignada a ti</strong><p>El contenido es de solo lectura. Emite una decisión.</p></div><div class="d-grid gap-2"><button class="btn btn-success" type="button" data-bs-toggle="modal" data-bs-target="#approveModal">Aprobar</button><button class="btn btn-outline-warning" type="button" data-bs-toggle="modal" data-bs-target="#changesModal">Solicitar correcciones</button><button class="btn btn-outline-danger" type="button" data-bs-toggle="modal" data-bs-target="#rejectModal">Rechazar</button></div> }
    else if (project.Status == ProjectAdministrativeStatus.Approved)
    {
        var completed = project.DevelopmentStatus == ProjectDevelopmentStatus.Completed;
        <p>Estado de desarrollo: <strong>@(completed ? "Terminado" : "En proceso")</strong>. El contenido académico permanece aprobado.</p>
        <form asp-action="@(completed ? "Reopen" : "Finish")" asp-route-id="@project.Id" method="post"
              data-confirm="@(completed ? "¿Confirmas que deseas reabrir este proyecto?" : "¿Confirmas que deseas marcar este proyecto como terminado?")">
            <button class="btn btn-primary w-100" type="submit">@(completed ? "Reabrir proyecto" : "Terminar proyecto")</button>
        </form>
    }
    else { <div class="empty-state border-0 shadow-none py-4"><span class="empty-illustration"><svg class="icon"><use href="/assets/icons.svg#icon-shield"></use></svg></span><h2>Sin acciones disponibles</h2><p>@(project.AssignedAdministratorName is not null ? $"Asignado a {project.AssignedAdministratorName}. Sólo esa persona puede decidir." : "El proyecto ya cuenta con una decisión o espera cambios del alumno.")</p></div> }
</section></aside></div>
<div class="modal fade" id="approveModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content border-0 rounded-4"><form asp-action="Approve" asp-route-id="@project.Id" method="post"><div class="modal-header"><h2 class="modal-title fs-5">Aprobar proyecto</h2><button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Cerrar"></button></div><div class="modal-body"><p>Aprobar acepta el contenido, pero no lo publica.</p><label class="form-label" for="approveNotes">Nota opcional</label><textarea class="form-control" id="approveNotes" name="notes" maxlength="2000" rows="4"></textarea></div><div class="modal-footer"><button class="btn btn-ghost" type="button" data-bs-dismiss="modal">Cancelar</button><button class="btn btn-success" type="submit" data-submit-once>Aprobar</button></div></form></div></div></div>
<div class="modal fade" id="rejectModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content border-0 rounded-4"><form asp-action="Reject" asp-route-id="@project.Id" method="post"><div class="modal-header"><h2 class="modal-title fs-5">Rechazar proyecto</h2><button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Cerrar"></button></div><div class="modal-body"><label class="form-label" for="rejectNotes">Motivo opcional</label><textarea class="form-control" id="rejectNotes" name="notes" maxlength="2000" rows="5"></textarea></div><div class="modal-footer"><button class="btn btn-ghost" type="button" data-bs-dismiss="modal">Cancelar</button><button class="btn btn-danger" type="submit" data-submit-once>Rechazar</button></div></form></div></div></div>
<div class="modal fade" id="changesModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-lg modal-dialog-centered"><div class="modal-content border-0 rounded-4"><form asp-action="RequestChanges" method="post" data-changes-form><input type="hidden" name="ProjectId" value="@project.Id" /><div class="modal-header"><div><h2 class="modal-title fs-5">Solicitar correcciones</h2><p class="small text-secondary mb-0">Debe existir una observación o al menos un requisito marcado.</p></div><button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Cerrar"></button></div><div class="modal-body"><label class="form-label" for="changeNotes">Observaciones</label><textarea class="form-control" id="changeNotes" name="Notes" maxlength="2000" rows="5"></textarea><fieldset class="mt-4"><legend class="form-label">Requisitos pendientes</legend><div class="requirement-checks">@foreach (var requirement in Model.Requirements) { <label><input class="form-check-input" type="checkbox" name="MissingRequirementIds" value="@requirement.Id" /><span><strong>@requirement.Name</strong><small>@requirement.Description</small></span></label> }</div></fieldset><div class="validation-summary-errors d-none mt-3" data-changes-error>Indica una observación o selecciona un requisito.</div></div><div class="modal-footer"><button class="btn btn-ghost" type="button" data-bs-dismiss="modal">Cancelar</button><button class="btn btn-primary" type="submit" data-submit-once>Enviar correcciones</button></div></form></div></div></div>
