@using PortalProyectos.Application.News
@using PortalProyectos.Domain.News
@model IReadOnlyList<NewsAdminItem>
@{ ViewData["Title"] = "Noticias"; var status = (NewsPostStatus?)ViewBag.Status; }
<div class="page-head"><div><span class="eyebrow">Contenido editorial</span><h1>Noticias y avisos</h1><p>Crea y administra el contenido que aparece en el portal público.</p></div><a class="btn btn-primary" href="/Admin/News/create">＋ Nueva noticia</a></div>
<section class="panel-card mb-4"><form method="get" class="news-admin-filters"><select class="form-select" name="status"><option value="">Todos los estados</option><option value="Draft" selected="@(status == NewsPostStatus.Draft)">Borradores</option><option value="Published" selected="@(status == NewsPostStatus.Published)">Publicadas</option><option value="Hidden" selected="@(status == NewsPostStatus.Hidden)">Ocultas</option></select><input class="form-control" name="search" value="@ViewBag.Search" placeholder="Buscar por título" /><label class="form-check d-flex align-items-center gap-2"><input class="form-check-input" type="checkbox" name="featured" value="true" checked="@((bool)ViewBag.Featured)" />Destacadas</label><button class="btn btn-primary">Filtrar</button></form></section>
<section class="panel-card"><div class="table-responsive"><table class="table align-middle admin-table"><thead><tr><th>Título</th><th>Estado</th><th>Destacada</th><th>Autor</th><th>Creada</th><th>Publicada</th><th></th></tr></thead><tbody>
@foreach (var item in Model) { var label = item.Status switch { NewsPostStatus.Draft => "Borrador", NewsPostStatus.Published => "Publicada", NewsPostStatus.Hidden => "Oculta", _ => "—" }; <tr><td><strong>@item.Title</strong></td><td><span class="news-status status-@item.Status.ToString().ToLowerInvariant()">@label</span></td><td>@(item.IsFeatured ? "Sí" : "—")</td><td>@item.Author</td><td>@item.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td><td>@(item.PublishedAtUtc?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "—")</td><td><a class="btn btn-sm btn-outline-primary" href="/Admin/News/@item.Id/edit">Gestionar</a></td></tr> }
@if (Model.Count == 0) { <tr><td colspan="7" class="text-center py-5 text-secondary">Todavía no hay noticias con estos filtros.</td></tr> }
</tbody></table></div></section>
