@using PortalProyectos.Domain.News
@model PortalProyectos.Web.Models.News.NewsPostFormViewModel
@{ ViewData["Title"] = Model.Id.HasValue ? "Editar noticia" : "Nueva noticia"; var isPublished = Model.Status == NewsPostStatus.Published; }
<div class="page-head"><div><span class="eyebrow">Contenido editorial @(Model.Id.HasValue ? $"· #{Model.Id}" : "· nuevo")</span><h1>@(Model.Id.HasValue ? "Editar noticia" : "Crear noticia")</h1><p>Borrador, medios y publicación se administran por separado.</p></div><a class="btn btn-ghost" href="/Admin/News">← Noticias</a></div>
<form method="post" action="/Admin/News/save" class="news-editor-form">
    @Html.AntiForgeryToken()<input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
    <section class="panel-card news-text-editor"><div class="news-editor-heading"><div><span class="eyebrow">Texto</span><h2>La historia</h2></div>@if (Model.Status.HasValue) { <span class="news-status status-@Model.Status.Value.ToString().ToLowerInvariant()">@Model.Status</span> }</div>
        <label asp-for="Title" class="form-label">Título</label><input asp-for="Title" class="form-control form-control-lg" maxlength="160" placeholder="Un título claro y atractivo" /><span asp-validation-for="Title" class="text-danger small"></span>
        <label asp-for="Summary" class="form-label mt-3">Resumen</label><textarea asp-for="Summary" class="form-control" maxlength="500" rows="3" placeholder="Texto breve para la tarjeta pública"></textarea><span asp-validation-for="Summary" class="text-danger small"></span>
        <label asp-for="Content" class="form-label mt-3">Contenido</label><textarea asp-for="Content" class="form-control news-content-input" maxlength="12000" rows="14" placeholder="Escribe el contenido como texto. Los saltos de línea se conservarán; no se permite HTML."></textarea><span asp-validation-for="Content" class="text-danger small"></span><small class="form-text">Texto seguro con saltos de línea. No admite HTML, scripts ni iframes.</small>
        <label class="form-check mt-3"><input asp-for="IsFeatured" class="form-check-input" /><span class="form-check-label">Destacar en el portal</span></label>
        <div class="news-save-actions"><button class="btn btn-outline-primary" type="submit" name="publishNow" value="false">Guardar borrador / cambios</button><button class="btn btn-primary" type="submit" name="publishNow" value="true">@(isPublished ? "Guardar y publicar cambios" : "Guardar y publicar")</button>@if (Model.Id.HasValue) { <a class="btn btn-ghost" href="/Admin/News/@Model.Id/preview" target="_blank">Vista previa ↗</a> }</div>
    </section>
</form>
@if (Model.Id.HasValue)
{
<div class="news-admin-content-grid"><main class="d-grid gap-4">
    <section class="panel-card"><div class="panel-card-head"><div><h2>Portada y galería</h2><p class="text-secondary mb-0">JPG, PNG o WebP · máximo 5 MB cada imagen</p></div></div>
        <form method="post" action="/Admin/News/@Model.Id/images" enctype="multipart/form-data" class="news-media-form">@Html.AntiForgeryToken()<label class="image-drop-zone"><input type="file" name="image" accept="image/jpeg,image/png,image/webp,.jpg,.jpeg,.png,.webp" required /><span><strong>Selecciona una imagen</strong><small>La primera se convierte en portada automáticamente.</small></span></label><input name="altText" class="form-control" maxlength="300" placeholder="Texto alternativo (opcional)" /><label class="form-check"><input type="checkbox" name="cover" value="true" class="form-check-input" /><span class="form-check-label">Usar como portada</span></label><button class="btn btn-primary">Subir imagen</button></form>
        <div class="news-admin-media-grid">@foreach (var item in Model.Media.Where(x => !x.IsVideo)) { <article class="news-admin-media"><img src="/Admin/News/@Model.Id/media/@item.Id" alt="@(item.AltText ?? item.FileName)" /><div class="news-media-meta"><strong>@item.FileName</strong><small>@(item.SizeBytes / 1024d / 1024d).ToString("0.0") MB · orden @item.SortOrder @if (item.IsCover) { <span class="news-status status-published">Portada</span> }</small></div><div class="news-media-actions">@if (!item.IsCover) { <form method="post" action="/Admin/News/@Model.Id/media/@item.Id/cover">@Html.AntiForgeryToken()<button class="btn btn-sm btn-outline-primary">Hacer portada</button></form> }<form method="post" action="/Admin/News/@Model.Id/media/@item.Id/order" class="news-order-form">@Html.AntiForgeryToken()<input type="number" class="form-control form-control-sm" min="0" max="1000" name="order" value="@item.SortOrder" aria-label="Orden" /><button class="btn btn-sm btn-ghost">Orden</button></form><form method="post" action="/Admin/News/@Model.Id/media/@item.Id/delete">@Html.AntiForgeryToken()<button class="btn btn-sm btn-outline-danger" data-confirm="¿Eliminar esta imagen y su archivo físico?">Eliminar</button></form></div></article> }</div>
    </section>
        <section class="panel-card"><div class="panel-card-head"><div><h2>Video local</h2><p class="text-secondary mb-0">MP4 · límite configurable: @(Convert.ToInt64(ViewBag.MaxNewsVideoBytes) / 1024 / 1024) MB</p></div></div><form method="post" action="/Admin/News/@Model.Id/video" enctype="multipart/form-data" class="news-media-form">@Html.AntiForgeryToken()<label class="image-drop-zone"><input type="file" name="video" accept="video/mp4,.mp4" data-max-bytes="@ViewBag.MaxNewsVideoBytes" required /><span><strong>Selecciona un video MP4</strong><small>Se reproduce desde el servidor local con controles y soporte Range.</small></span></label><button class="btn btn-outline-primary">Subir / reemplazar video</button></form>@foreach (var item in Model.Media.Where(x => x.IsVideo)) { <div class="news-video-admin"><video controls preload="metadata" src="/Admin/News/@Model.Id/media/@item.Id">Tu navegador no admite video HTML5.</video><div><strong>@item.FileName</strong><small>@(item.SizeBytes / 1024d / 1024d).ToString("0.0") MB</small><form method="post" action="/Admin/News/@Model.Id/media/@item.Id/delete">@Html.AntiForgeryToken()<button class="btn btn-sm btn-outline-danger" data-confirm="¿Eliminar el video local?">Eliminar video</button></form></div></div> }</section>
    <section class="panel-card"><div class="panel-card-head"><div><h2>Video externo</h2><p class="text-secondary mb-0">Sólo enlaces de YouTube; la reproducción requiere Internet.</p></div></div><form method="post" action="/Admin/News/@Model.Id/external-video" class="news-media-form">@Html.AntiForgeryToken()<label class="form-label" for="externalVideoUrl">URL de YouTube</label><input id="externalVideoUrl" name="url" value="@Model.ExternalVideoUrl" class="form-control" type="url" placeholder="https://youtu.be/XXXXXXXXXXX" /><div class="d-flex gap-2"><button class="btn btn-outline-primary">Guardar video externo</button><button class="btn btn-ghost" name="url" value="">Quitar</button></div></form></section>
    <section class="panel-card"><div class="panel-card-head"><div><h2>Enlaces relacionados</h2><p class="text-secondary mb-0">Sólo HTTP/HTTPS; se abren en otra pestaña con protección.</p></div></div><form method="post" action="/Admin/News/@Model.Id/links" class="news-link-form">@Html.AntiForgeryToken()<input class="form-control" name="label" maxlength="100" placeholder="Etiqueta: convocatoria" required /><input class="form-control" name="url" type="url" placeholder="https://..." required /><button class="btn btn-outline-primary">Agregar enlace</button></form><div class="news-link-list">@foreach (var link in Model.Links) { <div><a href="@link.Url" target="_blank" rel="noopener noreferrer">@link.Label ↗</a><form method="post" action="/Admin/News/@Model.Id/links/@link.Id/delete">@Html.AntiForgeryToken()<button class="btn btn-sm btn-ghost" aria-label="Eliminar enlace @link.Label">×</button></form></div> }</div></section>
</main><aside class="news-publish-sidebar"><section class="panel-card"><span class="eyebrow">Estado editorial</span><h2>@(isPublished ? "Publicada" : Model.Status == NewsPostStatus.Hidden ? "Oculta" : "Borrador")</h2><p class="text-secondary">Autor: @Model.Author<br />@(Model.PublishedAtUtc.HasValue ? $"Publicada: {Model.PublishedAtUtc.Value.ToLocalTime():dd/MM/yyyy HH:mm}" : "Todavía no publicada")</p>@if (isPublished) { <form method="post" action="/Admin/News/@Model.Id/visibility">@Html.AntiForgeryToken()<input type="hidden" name="visible" value="false" /><button class="btn btn-outline-warning w-100" data-confirm="¿Ocultar esta noticia del portal? Se conservarán sus medios.">Ocultar noticia</button></form> } else if (Model.Status == NewsPostStatus.Hidden) { <form method="post" action="/Admin/News/@Model.Id/visibility">@Html.AntiForgeryToken()<input type="hidden" name="visible" value="true" /><button class="btn btn-primary w-100">Volver a publicar</button></form> }</section>
    @if (Model.Status == NewsPostStatus.Draft && Model.PublishedAtUtc is null) { <section class="panel-card"><h2>Eliminar borrador</h2><p class="text-secondary">Sólo se pueden borrar noticias que nunca se publicaron.</p><form method="post" action="/Admin/News/@Model.Id/delete-draft">@Html.AntiForgeryToken()<button class="btn btn-outline-danger w-100" data-confirm="¿Eliminar definitivamente este borrador y sus archivos?">Eliminar borrador</button></form></section> }
</aside></div>
}
<partial name="_ValidationScriptsPartial" />
<script src="~/js/news-admin.js" asp-append-version="true"></script>
