@model PortalProyectos.Application.Storage.StorageDiagnosticSnapshot
@{ ViewData["Title"] = "Almacenamiento"; }
<div class="page-head"><div><span class="eyebrow">Diagnóstico sin borrado</span><h1>Almacenamiento</h1><p>Compara metadatos activos con los archivos físicos. Esta herramienta no elimina ni modifica archivos.</p></div><span class="status-badge badge-approved">Sólo lectura</span></div>
<section class="panel-card storage-root-card"><span class="eyebrow">Ruta configurada</span><code>@Model.RootPath</code><p class="small text-secondary mb-0">Mantén esta ruta fuera de la carpeta reemplazable de publicación y respáldala junto con SQLite y claves.</p></section>
<div class="stats-grid"><article class="stat-card"><strong class="stat-value">@Model.ActiveReferences</strong><span class="stat-label">Referencias activas</span></article><article class="stat-card"><strong class="stat-value">@Model.PhysicalFiles</strong><span class="stat-label">Archivos físicos</span></article><article class="stat-card"><strong class="stat-value">@((Model.PhysicalBytes / 1024d / 1024d).ToString("N1")) MB</strong><span class="stat-label">Espacio físico</span></article><article class="stat-card"><strong class="stat-value">@((Model.MissingFiles.Count + Model.OrphanFiles.Count))</strong><span class="stat-label">Diferencias detectadas</span></article></div>
<div class="row g-3"><div class="col-lg-6"><section class="panel-card"><h2>Referencias sin archivo</h2><p class="text-secondary">Archivos activos que faltan físicamente.</p>@if (Model.MissingFiles.Count == 0) { <p class="status-badge badge-approved">No se detectaron archivos faltantes.</p> } else { <ul class="storage-issue-list">@foreach (var x in Model.MissingFiles) { <li><code>@x.RelativePath</code><span>@x.MetadataBytes bytes</span></li> }</ul> }</section></div><div class="col-lg-6"><section class="panel-card"><h2>Archivos potencialmente huérfanos</h2><p class="text-secondary">No tienen referencia activa. No se borran automáticamente.</p>@if (Model.OrphanFiles.Count == 0) { <p class="status-badge badge-approved">No se detectaron candidatos.</p> } else { <ul class="storage-issue-list">@foreach (var x in Model.OrphanFiles) { <li><code>@x.RelativePath</code><span>@x.MetadataBytes bytes</span></li> }</ul> }</section></div></div>
