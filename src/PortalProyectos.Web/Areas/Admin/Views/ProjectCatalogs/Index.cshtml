@model PortalProyectos.Web.Models.Admin.ProjectCatalogsViewModel
@{ ViewData["Title"] = "Catálogos de proyectos"; }
<div class="page-head"><div><span class="eyebrow">Configuración académica</span><h1>Catálogos de proyectos</h1><p>Las opciones activas alimentan los formularios y la revisión sin listas escritas en las vistas.</p></div></div>
<div class="panel-card mb-4"><label for="catalogSearch" class="form-label">Buscar dentro de los catálogos</label><input id="catalogSearch" class="form-control" type="search" placeholder="Nombre, clave, carrera o descripción" /></div>
<div class="catalog-stack">
<section class="panel-card" id="subjects"><div class="panel-card-head"><div><h2>Materias</h2><p class="text-secondary mb-0">Cada materia pertenece a una carrera.</p></div><span class="status-badge badge-approved">@Model.Subjects.Count</span></div>
<form asp-action="SaveSubject" method="post" class="catalog-create-row"><input type="hidden" name="Id" value="0" /><div><label class="form-label" for="newSubjectName">Nueva materia</label><input class="form-control" id="newSubjectName" name="Name" required maxlength="120" /></div><div><label class="form-label" for="newSubjectCode">Clave</label><input class="form-control" id="newSubjectCode" name="Code" maxlength="24" /></div><div><label class="form-label" for="newSubjectCareer">Carrera</label><select class="form-select" id="newSubjectCareer" name="CareerId" asp-items="Model.Careers" required><option value="">Selecciona</option></select></div><input type="hidden" name="IsActive" value="true" /><button class="btn btn-primary" type="submit">Agregar</button></form>
<div class="catalog-edit-list">@foreach (var item in Model.Subjects) { <form asp-action="SaveSubject" method="post" class="catalog-edit-row"><input type="hidden" name="Id" value="@item.Id" /><input class="form-control" name="Name" value="@item.Name" required maxlength="120" aria-label="Nombre de materia" /><input class="form-control" name="Code" value="@item.Code" maxlength="24" aria-label="Clave" /><select class="form-select" name="CareerId" asp-items="Model.Careers.Select(x => new Microsoft.AspNetCore.Mvc.Rendering.SelectListItem(x.Text, x.Value, x.Value == item.CareerId.ToString()))" aria-label="Carrera"></select><span class="text-secondary small">Uso: @item.UsageCount</span><label class="catalog-toggle"><input class="form-check-input" type="checkbox" name="IsActive" value="true" checked="@item.IsActive" /> Activa</label><button class="btn btn-sm btn-outline-primary" type="submit">Guardar</button></form> }</div></section>
<section class="panel-card" id="cycles"><div class="panel-card-head"><div><h2>Ciclos escolares</h2><p class="text-secondary mb-0">Las fechas son informativas y opcionales.</p></div><span class="status-badge badge-approved">@Model.SchoolCycles.Count</span></div>
<form asp-action="SaveSchoolCycle" method="post" class="catalog-create-row four"><input type="hidden" name="Id" value="0" /><div><label class="form-label" for="newCycleName">Nuevo ciclo</label><input class="form-control" id="newCycleName" name="Name" required maxlength="100" /></div><div><label class="form-label" for="newCycleStart">Inicio</label><input class="form-control" id="newCycleStart" name="StartDate" type="date" /></div><div><label class="form-label" for="newCycleEnd">Fin</label><input class="form-control" id="newCycleEnd" name="EndDate" type="date" /></div><input type="hidden" name="IsActive" value="true" /><button class="btn btn-primary" type="submit">Agregar</button></form>
<div class="catalog-edit-list">@foreach (var item in Model.SchoolCycles) { <form asp-action="SaveSchoolCycle" method="post" class="catalog-edit-row"><input type="hidden" name="Id" value="@item.Id" /><input class="form-control" name="Name" value="@item.Name" required maxlength="100" aria-label="Nombre del ciclo" /><input class="form-control" name="StartDate" type="date" value="@item.StartDate?.ToString("yyyy-MM-dd")" aria-label="Inicio" /><input class="form-control" name="EndDate" type="date" value="@item.EndDate?.ToString("yyyy-MM-dd")" aria-label="Fin" /><span class="text-secondary small">Uso: @item.UsageCount</span><label class="catalog-toggle"><input class="form-check-input" type="checkbox" name="IsActive" value="true" checked="@item.IsActive" /> Activo</label><button class="btn btn-sm btn-outline-primary" type="submit">Guardar</button></form> }</div></section>
<section class="panel-card" id="types"><div class="panel-card-head"><div><h2>Tipos de proyecto</h2><p class="text-secondary mb-0">Clasificación editable de las propuestas.</p></div><span class="status-badge badge-approved">@Model.ProjectTypes.Count</span></div>
<form asp-action="SaveProjectType" method="post" class="catalog-create-row"><input type="hidden" name="Id" value="0" /><div><label class="form-label" for="newTypeName">Nuevo tipo</label><input class="form-control" id="newTypeName" name="Name" required maxlength="100" /></div><div class="catalog-wide"><label class="form-label" for="newTypeDescription">Descripción</label><input class="form-control" id="newTypeDescription" name="Description" maxlength="300" /></div><input type="hidden" name="IsActive" value="true" /><button class="btn btn-primary" type="submit">Agregar</button></form>
<div class="catalog-edit-list">@foreach (var item in Model.ProjectTypes) { <form asp-action="SaveProjectType" method="post" class="catalog-edit-row"><input type="hidden" name="Id" value="@item.Id" /><input class="form-control" name="Name" value="@item.Name" required maxlength="100" aria-label="Tipo" /><input class="form-control" name="Description" value="@item.Description" maxlength="300" aria-label="Descripción" /><span class="text-secondary small">Uso: @item.UsageCount</span><label class="catalog-toggle"><input class="form-check-input" type="checkbox" name="IsActive" value="true" checked="@item.IsActive" /> Activo</label><button class="btn btn-sm btn-outline-primary" type="submit">Guardar</button></form> }</div></section>
<section class="panel-card" id="requirements"><div class="panel-card-head"><div><h2>Requisitos de revisión</h2><p class="text-secondary mb-0">El administrador puede marcarlos cuando solicita correcciones.</p></div><span class="status-badge badge-approved">@Model.Requirements.Count</span></div>
<form asp-action="SaveRequirement" method="post" class="catalog-create-row"><input type="hidden" name="Id" value="0" /><div><label class="form-label" for="newRequirementName">Nuevo requisito</label><input class="form-control" id="newRequirementName" name="Name" required maxlength="120" /></div><div class="catalog-wide"><label class="form-label" for="newRequirementDescription">Descripción</label><input class="form-control" id="newRequirementDescription" name="Description" maxlength="300" /></div><div><label class="form-label" for="newRequirementOrder">Orden</label><input class="form-control" id="newRequirementOrder" name="SortOrder" type="number" min="0" max="999" value="0" /></div><input type="hidden" name="IsActive" value="true" /><button class="btn btn-primary" type="submit">Agregar</button></form>
<div class="catalog-edit-list">@foreach (var item in Model.Requirements) { <form asp-action="SaveRequirement" method="post" class="catalog-edit-row"><input type="hidden" name="Id" value="@item.Id" /><input class="form-control" name="Name" value="@item.Name" required maxlength="120" aria-label="Requisito" /><input class="form-control" name="Description" value="@item.Description" maxlength="300" aria-label="Descripción" /><input class="form-control" name="SortOrder" type="number" value="@item.SortOrder" min="0" max="999" aria-label="Orden" /><span class="text-secondary small">Uso: @item.UsageCount</span><label class="catalog-toggle"><input class="form-check-input" type="checkbox" name="IsActive" value="true" checked="@item.IsActive" /> Activo</label><button class="btn btn-sm btn-outline-primary" type="submit">Guardar</button></form> }</div></section>
<section class="panel-card" id="grades"><div class="panel-card-head"><div><h2>Grados</h2><p class="text-secondary mb-0">Uso indica perfiles más participaciones históricas referenciadas.</p></div><span class="status-badge badge-approved">@Model.Grades.Count</span></div>
<form asp-action="SaveGrade" method="post" class="catalog-create-row four"><input type="hidden" name="Id" value="0" /><input class="form-control" name="Name" required maxlength="40" placeholder="Nuevo grado" aria-label="Nuevo grado" /><input class="form-control" name="SortOrder" type="number" min="0" max="999" value="0" aria-label="Orden" /><input type="hidden" name="IsActive" value="true" /><button class="btn btn-primary" type="submit">Agregar grado</button></form>
<div class="catalog-edit-list">@foreach (var item in Model.Grades) { <form asp-action="SaveGrade" method="post" class="catalog-edit-row"><input type="hidden" name="Id" value="@item.Id" /><input class="form-control" name="Name" value="@item.Name" required maxlength="40" aria-label="Grado" /><input class="form-control" name="SortOrder" type="number" min="0" max="999" value="@item.SortOrder" aria-label="Orden" /><span class="text-secondary small">Uso: @item.UsageCount</span><label class="catalog-toggle"><input class="form-check-input" type="checkbox" name="IsActive" value="true" checked="@item.IsActive" /> Activo</label><button class="btn btn-sm btn-outline-primary">Guardar</button></form> }</div></section>
<section class="panel-card" id="groups"><div class="panel-card-head"><div><h2>Grupos</h2><p class="text-secondary mb-0">Los grupos relacionados se conservan; desactiva para retirarlos de nuevos formularios.</p></div><span class="status-badge badge-approved">@Model.Groups.Count</span></div>
<form asp-action="SaveGroup" method="post" class="catalog-create-row four"><input type="hidden" name="Id" value="0" /><input class="form-control" name="Name" required maxlength="40" placeholder="Nuevo grupo" aria-label="Nuevo grupo" /><input class="form-control" name="SortOrder" type="number" min="0" max="999" value="0" aria-label="Orden" /><input type="hidden" name="IsActive" value="true" /><button class="btn btn-primary" type="submit">Agregar grupo</button></form>
<div class="catalog-edit-list">@foreach (var item in Model.Groups) { <form asp-action="SaveGroup" method="post" class="catalog-edit-row"><input type="hidden" name="Id" value="@item.Id" /><input class="form-control" name="Name" value="@item.Name" required maxlength="40" aria-label="Grupo" /><input class="form-control" name="SortOrder" type="number" min="0" max="999" value="@item.SortOrder" aria-label="Orden" /><span class="text-secondary small">Uso: @item.UsageCount</span><label class="catalog-toggle"><input class="form-check-input" type="checkbox" name="IsActive" value="true" checked="@item.IsActive" /> Activo</label><button class="btn btn-sm btn-outline-primary">Guardar</button></form> }</div></section>
</div>
<script>
document.getElementById('catalogSearch')?.addEventListener('input', event => {
  const term = event.target.value.trim().toLocaleLowerCase();
  document.querySelectorAll('.catalog-edit-row').forEach(row => {
    const text = `${row.innerText} ${[...row.querySelectorAll('input:not([type=hidden])')].map(x => x.value).join(' ')}`.toLocaleLowerCase();
    row.hidden = term.length > 0 && !text.includes(term);
  });
});
</script>
