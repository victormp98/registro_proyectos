@using PortalProyectos.Application.Projects
@model IReadOnlyList<PublicationAdminItem>
@{ ViewData["Title"] = "Publicaciones"; var state = (string?)ViewBag.State; }
<div class="page-head"><div><span class="eyebrow">Portal público</span><h1>Publicaciones</h1><p>Decide qué proyectos aprobados se muestran y qué versión está vigente.</p></div><a class="btn btn-outline-primary" href="/proyectos" target="_blank">Ver portal público ↗</a></div>
<section class="panel-card mb-4"><form method="get" class="publication-admin-filters"><select class="form-select" name="state"><option value="">Todos los estados</option><option value="published" selected="@(state == "published")">Publicado</option><option value="hidden" selected="@(state == "hidden")">Oculto</option><option value="featured" selected="@(state == "featured")">Destacado</option><option value="unpublished" selected="@(state == "unpublished")">No publicado</option></select><select class="form-select" name="careerId"><option value="">Todas las carreras</option>@foreach (var x in (IReadOnlyList<PortalProyectos.Application.Catalogs.CareerItem>)ViewBag.Careers) { <option value="@x.Id" selected="@(ViewBag.CareerId == x.Id)">@x.Name</option> }</select><select class="form-select" name="cycleId"><option value="">Todos los ciclos</option>@foreach (var x in (IReadOnlyList<PortalProyectos.Application.Catalogs.SchoolCycleItem>)ViewBag.Cycles) { <option value="@x.Id" selected="@(ViewBag.CycleId == x.Id)">@x.Name</option> }</select><input class="form-control" name="search" value="@ViewBag.Search" placeholder="Proyecto o responsable" /><button class="btn btn-primary">Filtrar</button></form></section>
<section class="panel-card"><div class="table-responsive"><table class="table align-middle admin-table"><thead><tr><th>Proyecto</th><th>Responsable</th><th>Carrera · Ciclo</th><th>Revisión</th><th>Estado público</th><th>Versión</th><th>Likes</th><th></th></tr></thead><tbody>
@foreach (var item in Model) { <tr><td><strong>@item.Name</strong></td><td>@item.Responsible</td><td>@item.Career<br /><small>@item.Cycle</small></td><td><span class="status-badge project-status status-approved">@item.ReviewStatus</span></td><td><span class="publication-status @(item.IsPublished ? "is-live" : item.VersionId.HasValue ? "is-hidden" : "is-unpublished")">@(item.IsPublished ? "Publicado" : item.VersionId.HasValue ? "Oculto" : "No publicado")</span>@if (item.IsFeatured) { <span class="featured-mini">Destacado</span> }</td><td>@(item.VersionNumber?.ToString() ?? "—")</td><td>♥ @item.Likes</td><td><a class="btn btn-sm btn-outline-primary" href="/Admin/Publications/@item.ProjectId">Gestionar</a></td></tr> }
@if (Model.Count == 0) { <tr><td colspan="8" class="text-center py-5 text-secondary">No hay proyectos aprobados para publicar.</td></tr> }
</tbody></table></div></section>
