@using PortalProyectos.Application.Projects
@using PortalProyectos.Domain.Projects
@model PublicationAdminDetails
@{ ViewData["Title"] = "Gestionar publicación"; }
<div class="page-head"><div><span class="eyebrow">Publicación · Proyecto #@Model.ProjectId</span><h1>@Model.Name</h1><p>Responsable: @Model.Responsible</p></div><a class="btn btn-ghost" href="/Admin/Publications">← Publicaciones</a></div>
<div class="publication-admin-layout"><main class="d-grid gap-4">
<section class="panel-card"><div class="panel-card-head"><h2>Versión pública</h2><span class="publication-status @(Model.IsPublished ? "is-live" : "is-unpublished")">@(Model.IsPublished ? (Model.IsFeatured ? "Publicado · Destacado" : "Publicado") : "No publicado / oculto")</span></div>
<form method="post" action="/Admin/Publications/@Model.ProjectId/publish" class="publish-form">@Html.AntiForgeryToken()<label class="form-label" for="versionId">Selecciona una versión aprobada</label><select class="form-select" id="versionId" name="versionId" required data-preview-version>@foreach (var v in Model.ApprovedVersions) { <option value="@v.Id" data-name="@v.Name" data-career="@v.Career" data-subject="@v.Subject" data-cycle="@v.Cycle" data-type="@v.Type" data-development="@((int)v.DevelopmentStatus)" selected="@(Model.PublicVersionId == v.Id)">v@v.Number · @v.Name</option> }</select><label class="form-check mt-3"><input class="form-check-input" type="checkbox" name="featured" value="true" checked="@Model.IsFeatured" data-preview-featured /><span class="form-check-label">Destacar en el portal</span></label><p class="small text-secondary mt-2">Aprobar una versión no la publica ni reemplaza automáticamente la versión pública vigente.</p><button class="btn btn-primary" type="submit" disabled="@(Model.ApprovedVersions.Count == 0)">@(Model.IsPublished ? "Publicar esta versión" : "Publicar proyecto")</button></form>
@if (Model.IsPublished) { <div class="publication-controls"><form method="post" action="/Admin/Publications/@Model.ProjectId/visibility">@Html.AntiForgeryToken()<input type="hidden" name="visible" value="false" /><button class="btn btn-outline-warning" data-confirm="¿Ocultar este proyecto del portal? Se conservarán likes e imágenes." type="submit">Ocultar</button></form><form method="post" action="/Admin/Publications/@Model.ProjectId/featured">@Html.AntiForgeryToken()<input type="hidden" name="featured" value="@(!Model.IsFeatured ? "true" : "false")" /><button class="btn btn-outline-primary" type="submit">@(Model.IsFeatured ? "Quitar destacado" : "Destacar")</button></form><a href="/proyectos/@Model.ProjectId" class="btn btn-ghost" target="_blank">Vista previa ↗</a></div> }
</section>
<section class="panel-card"><div class="panel-card-head"><div><h2>Portada y galería</h2><p class="text-secondary mb-0">Imágenes opcionales · JPG, PNG o WebP · máximo 5 MB</p></div></div>
<form method="post" action="/Admin/Publications/@Model.ProjectId/images" enctype="multipart/form-data" class="image-upload-form">@Html.AntiForgeryToken()<label class="image-drop-zone"><input type="file" name="image" accept="image/jpeg,image/png,image/webp,.jpg,.jpeg,.png,.webp" required /><span><strong>Selecciona o arrastra una imagen</strong><small>Se guarda en el almacenamiento local protegido.</small></span></label><input class="form-control" name="altText" maxlength="300" placeholder="Texto alternativo para accesibilidad (opcional)" /><button class="btn btn-primary" type="submit">Subir imagen</button></form>
<div class="admin-image-grid">@foreach (var image in Model.Images) { <article class="admin-image-card"><img src="/Admin/Publications/images/@image.Id" alt="@(image.AltText ?? image.Name)" /><div class="admin-image-caption"><strong>@image.Name</strong><small>@(image.SizeBytes / 1024d / 1024d).ToString("0.0") MB · orden @image.SortOrder</small>@if (image.IsCover) { <span class="publication-status is-live">Portada</span> }</div><div class="admin-image-actions">@if (!image.IsCover) { <form method="post" action="/Admin/Publications/@Model.ProjectId/images/@image.Id/cover">@Html.AntiForgeryToken()<button class="btn btn-sm btn-outline-primary">Usar como portada</button></form> }<form method="post" action="/Admin/Publications/@Model.ProjectId/images/@image.Id/order" class="order-control">@Html.AntiForgeryToken()<input class="form-control form-control-sm" type="number" name="order" min="0" max="1000" value="@image.SortOrder" aria-label="Orden" /><button class="btn btn-sm btn-ghost">Guardar orden</button></form><form method="post" action="/Admin/Publications/@Model.ProjectId/images/@image.Id/delete">@Html.AntiForgeryToken()<button class="btn btn-sm btn-outline-danger" data-confirm="¿Eliminar la imagen y su archivo físico?" type="submit">Eliminar</button></form></div></article> }</div>
@if (Model.Images.Count == 0) { <div class="empty-state py-4"><h3>Sin imágenes todavía</h3><p>La publicación se verá con una portada gráfica generada por CSS.</p></div> }
</section></main><aside class="panel-card publication-preview"><span class="eyebrow">Vista previa</span><h2>Se verá así</h2>@{ var selected = Model.ApprovedVersions.FirstOrDefault(x => x.Id == Model.PublicVersionId) ?? Model.ApprovedVersions.FirstOrDefault(); var cover = Model.Images.FirstOrDefault(x => x.IsCover); var previewInitial = string.IsNullOrWhiteSpace(selected?.Name) ? "P" : selected.Name[..1].ToUpperInvariant(); }<article class="public-project-card publication-preview-card @(Model.IsFeatured ? "is-featured" : "")" data-publication-preview><div class="public-project-cover" aria-hidden="true">@if (cover is not null) { <img data-preview-cover src="/Admin/Publications/images/@cover.Id" alt="" /> } else { <span class="cover-pattern" data-preview-fallback><strong>@previewInitial</strong><small data-preview-type>@(selected?.Type ?? "Proyecto")</small></span> }<span class="development-chip" data-preview-development>@(selected?.DevelopmentStatus == ProjectDevelopmentStatus.Completed ? "Terminado" : "En proceso")</span></div><div class="public-project-content"><div class="project-eyebrow"><span data-preview-career>@(selected?.Career ?? "Sin carrera")</span> · <span data-preview-cycle>@(selected?.Cycle ?? "Sin ciclo")</span></div><h3 data-preview-name>@(selected?.Name ?? Model.Name)</h3><div class="public-project-tags"><span data-preview-subject>@(selected?.Subject ?? "Sin materia")</span><span data-preview-type>@(selected?.Type ?? "Sin tipo")</span></div><div class="public-project-footer"><span class="btn btn-outline-primary btn-sm">Ver proyecto →</span><span class="like-count">♡ @Model.LikeCount</span><span class="publication-status is-live" data-preview-featured-badge hidden>Destacado</span></div></div></article><p class="small text-secondary mt-3 mb-0">Portada y versión seleccionada se actualizarán en esta representación antes de publicar.</p><a href="/proyectos" target="_blank" rel="noopener noreferrer">Abrir portal público ↗</a></aside></div>
<script src="~/js/portal.js" asp-append-version="true"></script>
