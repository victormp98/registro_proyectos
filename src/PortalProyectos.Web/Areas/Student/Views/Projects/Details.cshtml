@model PortalProyectos.Application.Projects.ProjectDetails
@{
    ViewData["Title"] = "Detalle del proyecto";
    var document = ViewBag.ProjectDocument as PortalProyectos.Application.Notifications.ProjectDocumentItem;
    string StatusLabel(ProjectAdministrativeStatus status) => status switch { ProjectAdministrativeStatus.Draft => "Borrador", ProjectAdministrativeStatus.Submitted => "Enviado", ProjectAdministrativeStatus.UnderReview => "En revisión", ProjectAdministrativeStatus.ChangesRequested => "Correcciones", ProjectAdministrativeStatus.Resubmitted => "Reenviado", ProjectAdministrativeStatus.Approved => "Aprobado", _ => "Rechazado" };
    string EventLabel(ProjectHistoryEventType type) => type switch { ProjectHistoryEventType.Created => "Proyecto creado", ProjectHistoryEventType.Submitted => "Enviado a revisión", ProjectHistoryEventType.SubmissionCancelled => "Envío cancelado", ProjectHistoryEventType.ReviewStarted => "Revisión iniciada", ProjectHistoryEventType.ChangesRequested => "Correcciones solicitadas", ProjectHistoryEventType.Resubmitted => "Proyecto reenviado", ProjectHistoryEventType.Approved => "Proyecto aprobado", ProjectHistoryEventType.Rejected => "Proyecto rechazado", ProjectHistoryEventType.ParticipantAdded => "Participante agregado", ProjectHistoryEventType.ParticipantRemoved => "Participante retirado", _ => "Borrador actualizado" };
    string DecisionLabel(ProjectReviewDecision decision) => decision switch { ProjectReviewDecision.Pending => "Pendiente", ProjectReviewDecision.ChangesRequested => "Correcciones", ProjectReviewDecision.Approved => "Aprobado", ProjectReviewDecision.Rejected => "Rechazado", ProjectReviewDecision.Cancelled => "Cancelada", _ => decision.ToString() };
}
<div class="page-head"><div><span class="eyebrow">Proyecto #@Model.Id · versión @Model.VersionNumber</span><h1>@(string.IsNullOrWhiteSpace(Model.Name) ? "Proyecto sin nombre" : Model.Name)</h1><p>@Model.Subject · @Model.SchoolCycle</p></div><div class="d-flex gap-2 align-items-center"><span class="status-badge project-status status-@Model.Status.ToString().ToLowerInvariant()">@StatusLabel(Model.Status)</span>@if (Model.IsResponsible && Model.Status is ProjectAdministrativeStatus.Draft or ProjectAdministrativeStatus.ChangesRequested) { <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Editar</a> }</div></div>
@if (!Model.IsResponsible) { <div class="status-banner project-participation-banner"><svg class="icon"><use href="/assets/icons.svg#icon-users"></use></svg><div><strong>Participas en este proyecto</strong><p>Responsable: @Model.ResponsibleName. Puedes consultar su información, historial y documentación, pero no editarlo.</p></div></div> }
@if (Model.Status == ProjectAdministrativeStatus.ChangesRequested) { var correction = Model.Reviews.FirstOrDefault(x => x.Decision == ProjectReviewDecision.ChangesRequested); <section class="correction-callout"><svg class="icon"><use href="/assets/icons.svg#icon-clock"></use></svg><div><strong>El proyecto requiere correcciones</strong><p>@(correction?.Notes ?? "Consulta los requisitos marcados en el historial de revisión.")</p></div></section> }
<div class="project-detail-grid"><div class="d-grid gap-3"><section class="panel-card"><div class="panel-card-head"><h2>Información general</h2></div><dl class="detail-list"><div><dt>Materia</dt><dd>@Model.Subject</dd></div><div><dt>Tipo</dt><dd>@Model.ProjectType</dd></div><div><dt>Ciclo</dt><dd>@Model.SchoolCycle</dd></div><div><dt>Desarrollo</dt><dd>@(Model.Status != ProjectAdministrativeStatus.Approved ? "Disponible al aprobar" : Model.DevelopmentStatus == ProjectDevelopmentStatus.InProgress ? "En proceso" : "Terminado")</dd></div><div><dt>Asesor</dt><dd>@(Model.Advisor ?? "No especificado")</dd></div><div><dt>Fecha estimada</dt><dd>@(Model.EstimatedCompletionDate?.ToString("dd/MM/yyyy") ?? "No especificada")</dd></div></dl></section>
<section class="panel-card"><div class="content-block"><span class="eyebrow">Planteamiento</span><h2>Problema identificado</h2><p>@(string.IsNullOrWhiteSpace(Model.ProblemStatement) ? "Pendiente de completar." : Model.ProblemStatement)</p></div><div class="content-block"><span class="eyebrow">Propuesta</span><h2>Solución o innovación</h2><p>@(string.IsNullOrWhiteSpace(Model.ProposedSolution) ? "Pendiente de completar." : Model.ProposedSolution)</p></div></section>
@if (Model.IsResponsible && Model.Status == ProjectAdministrativeStatus.Approved)
{
    @await Html.PartialAsync("_ProjectParticipants", new PortalProyectos.Web.Models.Student.ProjectParticipantsViewModel(Model.Id, Model.Participants, (int)ViewBag.MaxParticipants))
}
else
{
<section class="panel-card"><div class="panel-card-head"><h2>Participantes</h2><span>@Model.Participants.Count</span></div><div class="participant-list">@foreach (var participant in Model.Participants) { <article class="participant-card"><span class="avatar">@participant.FullName[0]</span><div><strong>@participant.FullName</strong><span>@participant.Career@if (Model.IsResponsible) { <text> · @participant.Grade @participant.Group</text> }</span>@if (Model.IsResponsible) { <small>@(participant.IsResponsible ? "Responsable principal" : participant.UserId is null ? "Integrante histórico" : "Cuenta vinculada")</small> }</div></article> }</div></section>
}
</div>
@await Html.PartialAsync("_ProjectDocumentCard", new PortalProyectos.Web.Models.Student.ProjectDocumentCardViewModel(Model.Id, document, Model.IsResponsible && Model.Status is ProjectAdministrativeStatus.Draft or ProjectAdministrativeStatus.ChangesRequested or ProjectAdministrativeStatus.Approved, Model.IsResponsible && Model.Status == ProjectAdministrativeStatus.Approved))
<aside class="d-grid gap-3 align-content-start"><section class="panel-card"><div class="panel-card-head"><h2>Línea de tiempo</h2></div><div class="review-timeline">@foreach (var item in Model.History) { <article><span class="timeline-dot"></span><div><strong>@EventLabel(item.EventType)</strong><p>@item.Notes</p><small>@item.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm") · @item.ActorDisplayName @if (item.ReviewNumber.HasValue) { <text>· revisión @item.ReviewNumber</text> }</small></div></article> }</div></section>
@if (Model.Reviews.Count > 0) { <section class="panel-card"><div class="panel-card-head"><h2>Revisiones</h2></div>@foreach (var review in Model.Reviews) { <article class="review-summary"><strong>Revisión @review.ReviewNumber · v@review.VersionNumber</strong><span>@DecisionLabel(review.Decision)</span>@if (!string.IsNullOrWhiteSpace(review.Notes)) { <p>@review.Notes</p> }@if (review.Requirements.Count > 0) { <ul>@foreach (var req in review.Requirements) { <li>@req.Name</li> }</ul> }</article> }</section> }
</aside></div>
