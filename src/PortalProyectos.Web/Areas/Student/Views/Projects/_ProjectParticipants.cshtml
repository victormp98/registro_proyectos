@model PortalProyectos.Web.Models.Student.ProjectParticipantsViewModel
<section class="panel-card mt-4" id="participantes"><div class="panel-card-head"><div><h2>Participantes</h2><p class="text-secondary mb-0">@Model.Participants.Count de @Model.MaxParticipants lugares ocupados. El responsable cuenta dentro del límite.</p></div><button class="btn btn-primary btn-sm" type="button" data-bs-toggle="modal" data-bs-target="#participantModal" disabled="@(Model.Participants.Count >= Model.MaxParticipants)">Agregar participante</button></div>
<div class="participant-list">@foreach (var participant in Model.Participants) { <article class="participant-card"><span class="avatar @(participant.IsResponsible ? "avatar-admin" : "")">@participant.FullName[0]</span><div><strong>@participant.FullName</strong><span>@participant.StudentNumber · @participant.Career · @participant.Grade @participant.Group</span><small>@(participant.IsResponsible ? "Responsable principal" : participant.UserId is not null ? "Cuenta vinculada y confirmada" : "Registro histórico")</small></div>@if (!participant.IsResponsible) { <form asp-action="RemoveParticipant" method="post" data-confirm="¿Retirar a este participante?"><input type="hidden" name="projectId" value="@Model.Id" /><input type="hidden" name="participantId" value="@participant.Id" /><button class="btn btn-sm btn-ghost" type="submit">Retirar</button></form> }</article> }</div>
</section>
<div class="modal fade" id="participantModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-lg modal-dialog-centered"><div class="modal-content border-0 rounded-4"><div class="modal-header"><div><h2 class="modal-title fs-5 fw-bold">Agregar participante</h2><p class="small text-secondary mb-0">Busca su matrícula. Debe tener una cuenta registrada y aprobada en el Portal de Proyectos.</p></div><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button></div><div class="modal-body">
    <section><label for="linkedStudentNumber" class="form-label">Matrícula</label><div class="input-group"><input id="linkedStudentNumber" class="form-control" maxlength="32" placeholder="Buscar matrícula" /><button class="btn btn-outline-primary" type="button" data-participant-search data-url="@Url.Action("FindParticipant")" data-project-id="@Model.Id">Buscar</button></div><div class="linked-result" data-linked-result aria-live="polite"></div><form asp-action="AddLinkedParticipant" method="post" class="d-none mt-3" data-linked-confirm-form><input type="hidden" name="projectId" value="@Model.Id" /><input type="hidden" name="linkedUserId" /><button class="btn btn-primary w-100" type="submit">Confirmar y agregar</button></form></section>
</div></div></div></div>
