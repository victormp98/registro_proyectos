@using PortalProyectos.Application.News
@model NewsPage
@{ ViewData["Title"] = "Noticias"; }
<section class="news-list-hero"><div class="container-xl news-list-heading"><div><span class="hero-kicker">Novedades y avisos</span><h1>Noticias del portal</h1><p>Información y publicaciones de la comunidad académica.</p></div><form method="get" action="/noticias" class="news-search-form" role="search"><label class="visually-hidden" for="newsSearch">Buscar noticias</label><input id="newsSearch" name="search" value="@ViewBag.Search" class="form-control" placeholder="Buscar por título o resumen" /><button class="btn btn-primary" type="submit">Buscar</button></form></div></section>
<div class="container-xl news-list-page">
    @if (Model.Items.Count == 0) { <div class="empty-state news-empty"><span class="empty-illustration"><svg class="icon"><use href="/assets/icons.svg#icon-book"></use></svg></span><h2>No hay noticias publicadas con esa búsqueda</h2><p>Prueba con otro término o vuelve a consultar más adelante.</p></div> }
    else { <div class="news-card-grid">@foreach (var post in Model.Items) { <article class="news-card @(post.IsFeatured ? "is-featured" : "")"><a class="news-card-cover" href="/noticias/@post.Id">@if (post.CoverUrl is not null) { <img src="@post.CoverUrl" alt="Portada: @post.Title" loading="lazy" /> } else { <span class="news-cover-pattern"><svg class="icon"><use href="/assets/icons.svg#icon-book"></use></svg><strong>@post.Title[..1].ToUpperInvariant()</strong></span> }@if (post.IsFeatured) { <span class="news-featured-badge">Destacada</span> }</a><div class="news-card-body"><div class="news-card-date">@(post.PublishedAtUtc?.ToLocalTime().ToString("dd MMM yyyy") ?? "Portal de Proyectos")</div><h2><a href="/noticias/@post.Id">@post.Title</a></h2><p>@post.Summary</p><a class="news-read-more" href="/noticias/@post.Id">Leer más <span aria-hidden="true">→</span></a></div></article> }</div>
        @if (Model.TotalPages > 1) { <nav class="publication-pagination" aria-label="Paginación de noticias">@for (var i = 1; i <= Model.TotalPages; i++) { <a class="@(i == Model.Page ? "active" : "")" href="@Url.Action("Index", new { search = ViewBag.Search, page = i })" aria-current="@(i == Model.Page ? "page" : null)">@i</a> }</nav> }
    }
</div>
