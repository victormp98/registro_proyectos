@model PortalProyectos.Web.Models.ErrorViewModel
@{ ViewData["Title"] = "Error"; }
<section class="container-xl py-5"><div class="empty-state"><span class="empty-illustration"><svg class="icon"><use href="/assets/icons.svg#icon-shield"></use></svg></span><span class="eyebrow">Error interno · 500</span><h1>No pudimos completar la solicitud</h1><p>Ocurrió un problema inesperado. Intenta de nuevo; si continúa, comparte el identificador con soporte.</p>@if (Model.ShowRequestId) { <p class="small text-secondary">Referencia: <code>@Model.RequestId</code></p> }<a class="btn btn-primary" href="/">Volver al portal</a></div></section>
