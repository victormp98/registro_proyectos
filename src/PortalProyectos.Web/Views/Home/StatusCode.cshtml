@model int
@{ ViewData["Title"] = Model switch { 403 => "Acceso denegado", 404 => "No encontrado", _ => "Error" }; var heading = Model switch { 403 => "No tienes permiso para ver esta página", 404 => "No encontramos esa página", _ => "No pudimos completar la solicitud" }; var message = Model switch { 403 => "Tu sesión no cuenta con el acceso requerido.", 404 => "La dirección puede haber cambiado o el contenido ya no está disponible.", _ => "Ocurrió un problema inesperado. Intenta de nuevo más tarde." }; }
<section class="container-xl py-5"><div class="empty-state"><span class="empty-illustration"><svg class="icon"><use href="/assets/icons.svg#icon-shield"></use></svg></span><span class="eyebrow">Error @Model</span><h1>@heading</h1><p>@message</p><a class="btn btn-primary" href="/">Volver al portal</a></div></section>
