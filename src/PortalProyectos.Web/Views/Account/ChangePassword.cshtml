@model PortalProyectos.Web.Models.Account.ChangePasswordViewModel
@{ ViewData["Title"] = "Cambiar contraseña"; }
<section class="auth-page"><div class="container-xl"><div class="auth-wrap" style="max-width:860px">
    <aside class="auth-aside"><span class="hero-kicker">Paso de seguridad</span><h1>Protege tu cuenta.</h1><p>La contraseña temporal solo sirve para el primer acceso. Define una nueva antes de continuar.</p></aside>
    <div class="auth-form"><span class="eyebrow">Cambio obligatorio</span><h2>Nueva contraseña</h2><p class="form-intro">No podrás abrir otra sección hasta completar este paso.</p>
        <form asp-action="ChangePassword" method="post"><div asp-validation-summary="ModelOnly"></div>
            <div class="mb-3"><label asp-for="CurrentPassword" class="form-label"></label><div class="password-input-group"><input asp-for="CurrentPassword" class="form-control" autocomplete="current-password" /><button class="password-toggle" type="button" data-password-toggle aria-controls="CurrentPassword" aria-label="Mostrar contraseña" aria-pressed="false" title="Mostrar contraseña"><svg class="icon" aria-hidden="true"><use href="/assets/icons.svg#icon-eye"></use></svg></button></div><span asp-validation-for="CurrentPassword"></span></div>
            <div class="mb-3"><label asp-for="NewPassword" class="form-label"></label><div class="password-input-group"><input asp-for="NewPassword" class="form-control" autocomplete="new-password" /><button class="password-toggle" type="button" data-password-toggle aria-controls="NewPassword" aria-label="Mostrar contraseña" aria-pressed="false" title="Mostrar contraseña"><svg class="icon" aria-hidden="true"><use href="/assets/icons.svg#icon-eye"></use></svg></button></div><span asp-validation-for="NewPassword"></span></div>
            <div class="mb-4"><label asp-for="ConfirmPassword" class="form-label"></label><div class="password-input-group"><input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" /><button class="password-toggle" type="button" data-password-toggle aria-controls="ConfirmPassword" aria-label="Mostrar contraseña" aria-pressed="false" title="Mostrar contraseña"><svg class="icon" aria-hidden="true"><use href="/assets/icons.svg#icon-eye"></use></svg></button></div><span asp-validation-for="ConfirmPassword"></span></div>
            <button class="btn btn-primary w-100" type="submit">Guardar contraseña y continuar</button>
        </form>
    </div>
</div></div></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
