{
  "Data": {
    "DatabasePath": "../data/portalproyectos.db"
  },
  "DataProtection": {
    "KeysPath": "../data/keys"
  },
  "Storage": {
    "RootPath": "../storage",
    "MaxProjectPdfBytes": 10485760,
    "MaxNewsVideoBytes": 104857600
  },
  "Backups": {
    "RootPath": "../backups"
  },
  "Server": {
    "Urls": ""
  },
  "Portal": {
    "UseHttpsRedirection": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  }
}
